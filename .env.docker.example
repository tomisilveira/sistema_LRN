# ==========================================================================
# Variables para desplegar con Docker (ver docs/DEPLOY.md).
# Copiar a `.env.docker` (NO se sube a git) y completar.
#
# Hay DOS momentos distintos:
#   [BUILD]   se pasan con --build-arg y quedan dentro de la imagen.
#   [RUNTIME] se pasan al contenedor (-e / env_file / secret de k8s).
# ==========================================================================

# ---- [BUILD] obligatorias ------------------------------------------------
# URL de Supabase tal como la ven los NAVEGADORES (no una URL interna):
# el navegador se conecta directo a Supabase para el login y el tiempo real.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon key (pública por diseño; la protege la RLS de la base).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- [BUILD + RUNTIME] ---------------------------------------------------
# URL pública del sistema, sin barra final.
SITE_URL=https://liga.ejemplo.gob.ar

# ---- [RUNTIME] obligatoria, SECRETA --------------------------------------
# service_role key: saltea la seguridad de la base. Solo el servidor la usa
# (juez, acreditación, inscripción, alta de usuarios). Nunca en el build,
# nunca en logs, nunca en el navegador. Guardarla como secreto.
SUPABASE_SERVICE_ROLE_KEY=

# ---- [BUILD] opcionales --------------------------------------------------
# Solo si detrás del proxy los botones del panel fallan con "Invalid Server
# Actions request" (el proxy reescribe el Host). Separados por coma.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Solo con MÁS DE UNA réplica: misma clave en todas las réplicas o los
# botones fallan al azar. Generar una vez con:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Solo con más de una réplica / deploys graduales: un id por versión
# (ej. el tag de la imagen o el commit).
DEPLOYMENT_ID=

# Registry npm interno, si el build no tiene salida a internet.
NPM_CONFIG_REGISTRY=

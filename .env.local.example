# Copiar a .env.local y completar con los datos de tu proyecto Supabase
# (Project Settings → API).

# URL del proyecto, ej: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — segura para exponer en el navegador (RLS la protege)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — NUNCA exponer al navegador. Solo se usa server-side
# (endpoint de carga de resultados del juez). Mantener fuera de git.
SUPABASE_SERVICE_ROLE_KEY=
